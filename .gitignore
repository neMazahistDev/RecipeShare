# ==========================================
# 1. Python и виртуальное окружение
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# ==========================================
# 2. Секреты и переменные окружения (ВАЖНО!)
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# 3. Django (База данных, логи, статика)
# ==========================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Загруженные пользователями файлы (картинки рецептов)
media/

# Собранная статика (если будете использовать collectstatic)
staticfiles/

# ==========================================
# 4. Настройки IDE (PyCharm, VS Code)
# ==========================================
.idea/
.vscode/
*.swp

# ==========================================
